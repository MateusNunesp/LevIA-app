{
  "name": "levia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "LEVIA_DEMO=1 node scripts/dev.mjs",
    "seed": "tsx scripts/seed-demo.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm deps && pnpm test && pnpm legibilidade",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @levia/mobile typecheck",
    "deps": "depcruise packages apps/api/src apps/mobile/src apps/mobile/app --config .dependency-cruiser.cjs",
    "test": "vitest run && pnpm --filter @levia/mobile test",
    "legibilidade": "tsx scripts/legibilidade.ts",
    "e2e": "maestro test apps/mobile/.maestro",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^17.3.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  }
}
