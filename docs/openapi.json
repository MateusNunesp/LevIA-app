    "/v1/rh/agregados": {
      "get": {
        "summary": "Agregados setor x mês, k >= 10",
        "parameters": [
          {
            "name": "x-levia-dispositivo",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
