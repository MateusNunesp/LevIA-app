                              "saida_2",
                              "saida_3",
                              "regiao_pescoco",
                              "regiao_ombros",
                              "regiao_costas_alta",
                              "regiao_lombar",
                              "regiao_cotovelos",
                              "regiao_punhos_maos",
                              "regiao_quadril",
                              "regiao_joelhos",
                              "regiao_tornozelos_pes",
                              "ritmo_constancia_pct"
                            ]
                          },
                          "valor": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "suprimido": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "setor",
                          "mes",
                          "indicador",
                          "valor",
                          "suprimido"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "aviso": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "celulas",
                    "aviso"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
