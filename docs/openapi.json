    "/v1/bench/triage": {
      "post": {
        "summary": "Só com LEVIA_MODE=bench",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "respostas": {
                    "type": "object",
                    "properties": {
                      "regioes": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "pescoco",
                            "ombros",
                            "costas_alta",
                            "lombar",
                            "cotovelos",
                            "punhos_maos",
                            "quadril",
                            "joelhos",
                            "tornozelos_pes"
                          ]
                        }
                      },
                      "duracaoDias": {
                        "type": "number",
                        "minimum": 0
                      },
                      "dorNota": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10
                      },
                      "achados": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "boolean"
                        }
                      },
                      "startBack": {
                        "minItems": 9,
                        "maxItems": 9,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "required": [
                      "regioes",
                      "duracaoDias",
                      "dorNota",
                      "achados",
                      "startBack"
                    ],
                    "additionalProperties": false
                  },
                  "historico": {},
                  "hoje": {
                    "type": "string"
                  }
                },
                "required": [
                  "respostas"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/bench/conversa": {
      "post": {
        "summary": "Só com LEVIA_MODE=bench",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "mensagens": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "mapa": {
