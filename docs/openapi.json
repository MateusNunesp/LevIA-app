{
  "openapi": "3.1.0",
  "info": {
    "title": "LevIA API",
    "version": "0.1.0",
    "description": "Só API (sem páginas web). O RH só recebe agregados."
  },
  "paths": {
    "/v1/dispositivos": {
      "post": {
        "summary": "Registra o identificador provisório do aparelho",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/consentimentos": {
      "post": {
        "summary": "Dá um consentimento",
        "parameters": [
          {
            "name": "x-levia-dispositivo",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador provisório do aparelho. TODO(login)."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "triagem",
                      "ritmo"
                    ]
                  },
                  "versao": {
                    "type": "number"
                  }
                },
                "required": [
                  "tipo",
                  "versao"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/consentimentos/{tipo}": {
      "delete": {
        "summary": "Revoga um consentimento (triagem: apaga dados de saúde)",
        "parameters": [
          {
            "name": "x-levia-dispositivo",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
