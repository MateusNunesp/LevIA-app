          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/sessoes": {
      "post": {
        "summary": "Começa uma conversa",
        "parameters": [
          {
            "name": "x-levia-dispositivo",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador provisório do aparelho. TODO(login)."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "mensagens": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "tipo": {
                                "type": "string",
                                "const": "texto"
                              },
                              "textoId": {
                                "type": "string"
                              },
                              "texto": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "tipo",
                              "textoId",
                              "texto"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "tipo": {
                                "type": "string",
                                "const": "cartao_mapa"
                              },
                              "textoId": {
                                "type": "string"
                              },
                              "texto": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "tipo",
                              "textoId",
                              "texto"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "tipo": {
                                "type": "string",
                                "const": "resultado"
                              },
                              "saida": {
                                "anyOf": [
                                  {
                                    "type": "number",
                                    "const": 1
                                  },
                                  {
                                    "type": "number",
                                    "const": 2
                                  },
                                  {
                                    "type": "number",
                                    "const": 3
                                  }
                                ]
                              },
                              "urgenteHoje": {
                                "type": "boolean"
                              },
                              "titulo": {
                                "type": "string"
                              },
                              "texto": {
                                "type": "string"
                              },
                              "porque": {
                                "type": "string"
                              },
                              "episodioId": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "tipo",
                              "saida",
                              "urgenteHoje",
                              "titulo",
                              "texto",
                              "porque",
                              "episodioId"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "tipo": {
                                "type": "string",
                                "const": "resumo"
                              },
                              "episodioId": {
                                "type": "string"
                              },
                              "texto": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "tipo",
                              "episodioId",
                              "texto"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "tipo": {
                                "type": "string",
                                "const": "exercicio"
                              },
                              "exercicioId": {
                                "type": "string"
                              },
                              "nome": {
                                "type": "string"
                              },
                              "passos": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "dose": {
                                "type": "string"
                              },
                              "quandoParar": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "tipo",
                              "exercicioId",
                              "nome",
                              "passos",
                              "dose",
                              "quandoParar"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "tipo": {
                                "type": "string",
                                "const": "emergencia"
                              },
                              "motivo": {
                                "type": "string",
                                "enum": [
                                  "cardiaca",
                                  "avc",
                                  "autolesao",
                                  "alerta"
                                ]
                              },
                              "texto": {
                                "type": "string"
                              },
                              "telefones": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "required": [
                              "tipo",
                              "motivo",
                              "texto",
                              "telefones"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "mensagens"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
